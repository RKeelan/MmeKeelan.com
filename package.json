{
  "name": "mmekeelan",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "homepage": "https://rkeelan.github.io/MmeKeelan.com",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "dev": "bun scripts/dev.ts",
    "build": "bun build ./src/*.html --root ./src --splitting --minify --public-path /MmeKeelan.com/ --outdir dist",
    "preview": "bun scripts/preview.ts",
    "upgrade-deps": "ncu -u && bun install",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bun check",
    "check-all": "bun run lint && bun run typecheck && bun run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "20.14.6",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.2",
    "npm-check-updates": "23.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "js-yaml": "5.4.2",
    "jspdf": "4.2.1"
  },
  "overrides": {
    "dompurify": ">=3.4.16",
    "fflate": ">=0.8.3"
  }
}
